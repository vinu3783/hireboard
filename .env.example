# Runtime connection string used by the app (use the *pooled* URL on Neon/Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
